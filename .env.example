# Copy to .env.local (web) or .env (worker). Never commit real values.

# Postgres (Supabase or Neon). Leave empty to use the local PGlite server from `pnpm db:dev`.
DATABASE_URL=

# Milestone 1: worker. The contact email goes in the User-Agent so clubs can reach us.
BOOKON_CONTACT_EMAIL=info@bookon.com.au
# The public site address, for the user agent and links in emails. Required in production.
# Leave empty locally so the worker's alert emails link to http://localhost:3000.
BOOKON_SITE_URL=
POLL_INTERVAL_MINUTES=30
MIN_REQUEST_INTERVAL_MS=3000

# Milestone 3: signs Book links (/go/...). Required in production, or clicks aren't tracked.
# Make one with: openssl rand -base64 32
CLICK_SIGNING_SECRET=

# Milestone 4: email (sign-in links and alerts). Without EMAIL_PROVIDER=postmark, emails are
# kept in the database and shown at http://localhost:3000/dev/outbox instead of being sent.
EMAIL_PROVIDER=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=BookOn <info@bookon.com.au>

# Milestone 5: push notifications. Required in production, the same pair on the website and
# worker (make them with: pnpm push:keys). Locally, leave empty: a pair is made and kept in
# the database for you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Milestone 6: admin login
ADMIN_PASSWORD_HASH=

# Milestone 7: error monitoring
SENTRY_DSN=
