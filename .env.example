# Copy to .env.local (web) or .env (worker). Never commit real values.

# Postgres (Supabase or Neon). Leave empty to use the local PGlite server from `pnpm db:dev`.
DATABASE_URL=

# Milestone 1: worker. The contact email goes in the User-Agent so clubs can reach us.
BOOKON_CONTACT_EMAIL=info@bookon.au
# The public site address, for the user agent and links in emails. Required in production.
# Leave empty locally so the worker's alert emails link to http://localhost:3000.
BOOKON_SITE_URL=
POLL_INTERVAL_MINUTES=30
MIN_REQUEST_INTERVAL_MS=3000

# Milestone 3: signs Book links (/go/...). Required in production, or clicks aren't tracked.
# Make one with: openssl rand -base64 32
CLICK_SIGNING_SECRET=

# Milestone 4: email (sign-in links and alerts). Without EMAIL_PROVIDER=postmark, emails are
# kept in the database and shown at http://localhost:3000/dev/outbox instead of being sent.
EMAIL_PROVIDER=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=BookOn <info@bookon.au>
# Milestone 27: tee time alerts come from here; replies go to EMAIL_FROM.
EMAIL_ALERTS_FROM=BookOn alerts <alerts@bookon.au>

# Milestone 8: who can open the admin area (/admin). One email only: BookOn has one admin, and
# admin stays off if more than one is set. They sign in with the usual emailed link, and again
# every 12 hours.
BOOKON_ADMIN_EMAIL=
# Milestone 23: the worker needs BOOKON_ADMIN_EMAIL too, for the Monday analytics summary email.

# Milestone 15: lesson payments with Stripe Connect. Without a key, a local database uses practice
# payments (no money moves) and a hosted site has lesson payments off. Use test keys (sk_test_...)
# until launch. The webhook secret comes from the Stripe dashboard (or `stripe listen` locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Milestone 14: private test mode. Set a password and the whole site asks for it (any user
# name), and search engines are told to keep out. Remove it at launch.
BOOKON_SITE_PASSWORD=
# Tester links: while the site password is on, /?tester=<this code> lets a phone or computer in for
# 30 days without the password box (so testers can use the Home Screen app and notifications).
# Make one with: openssl rand -hex 12. Change it to lock everyone out. Admin, Settings shows the link.
BOOKON_TESTER_CODE=

# Milestone 7: where new club listings are sent for review (defaults to BOOKON_CONTACT_EMAIL).
BOOKON_OWNER_EMAIL=

# Milestone 5: push notifications. Required in production, the same pair on the website and
# worker (make them with: pnpm push:keys). Locally, leave empty: a pair is made and kept in
# the database for you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Milestone 6: admin login
ADMIN_PASSWORD_HASH=

# Milestone 7: error monitoring
SENTRY_DSN=

# Milestone 27: the newsletter. BookOn keeps the list and copies it to one Mailchimp audience,
# where newsletters are written and sent. Set the key and audience on the worker (it does the
# copying) and the website (for Admin, Newsletter). Without them, sign-ups wait in BookOn.
# In Mailchimp, add a webhook to https://<site>/api/mailchimp/webhook?key=<MAILCHIMP_WEBHOOK_SECRET>
# for unsubscribes, cleaned addresses, subscribes and email changes. Make the secret with:
# openssl rand -hex 24
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_WEBHOOK_SECRET=
