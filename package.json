{
  "name": "bookon",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bookon/web dev",
    "dev:worker": "pnpm --filter @bookon/worker dev",
    "db:seed": "pnpm --filter @bookon/db seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:dev": "pnpm --filter @bookon/db dev",
    "stats": "pnpm --filter @bookon/db stats",
    "alerts": "pnpm --filter @bookon/worker alerts",
    "clubs": "pnpm --filter @bookon/worker clubs",
    "push:keys": "pnpm --filter @bookon/email exec web-push generate-vapid-keys"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
